# =========================================================================
# AEGIS AI - MEDICAL CHATBOT PLATFORM ENVIRONMENT CONFIGURATION
# =========================================================================

# 🩺 Groq AI API Key (Required for LLM)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# 🌲 Pinecone Vector DB Configuration (Required for RAG)
# Obtain at: https://www.pinecone.io/
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX="medical-chatbot"

# 🔒 JWT Secure Token Encryption (Used in user authentication sessions)
# Generate a secure secret string using: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_a_secure_random_hex_string_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 🗄️ Database Connection
# By default, aegis falls back to local SQLite: sqlite:///./medical.db
# To connect to production Supabase PostgreSQL, specify the connection string:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
DATABASE_URL="sqlite:///./medical.db"

# 🖥️ Host & Port Configs (Used by Render/Local servers)
PORT=10000
HOST="0.0.0.0"

# 🖥️ React Frontend configuration (Only required in production if URL differs)
# VITE_API_URL="https://your-backend-render-url.onrender.com"
VITE_API_URL=""
